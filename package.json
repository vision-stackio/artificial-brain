{
  "name": "artificial brain",
  "version": "0.1.0",
  "private": true,
  "description": "browser based artificial brain for Vision",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "build:client": "tsx scripts/build-client.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "express": "^4.21.0",
    "sharp": "^0.33.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
